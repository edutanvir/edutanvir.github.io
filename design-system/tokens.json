  "typography": {
    "hero": {
      "weight": 800,
      "tracking": "-0.065em",
      "lineHeight": 0.92,
      "size": "clamp(3.6rem, 11.5vw, 9rem)"
    },
    "h2": {
      "weight": 700,
      "tracking": "-0.055em",
      "lineHeight": 0.96,
      "size": "clamp(2.4rem, 6vw, 4.75rem)"
    }
  },
  "border": {
    "width": {
      "$value": "2px",
      "$type": "dimension"
    },
    "radius": {
      "$value": "0",
      "$type": "dimension"
    }
  },
  "shadow": {
    "hard": {
      "$value": "4px 4px 0 currentColor",
      "$type": "shadow"
    }
  },
  "themes": {
    "dark": {
      "bg": "#1e1e1e",
      "text": "#f8f8f8",
      "surface": "#2a2a2a"
    },
    "light": {
      "bg": "#fefefe",
